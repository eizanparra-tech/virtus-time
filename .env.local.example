# =============================================================================
# VIRTUS TIME — Variables de entorno
#
# Copia este archivo a ".env.local" (en la raíz del proyecto) y rellena los
# valores con los de tu proyecto de Supabase.
#
# NUNCA subas ".env.local" a git ni lo compartas: contiene claves secretas.
# =============================================================================

# Supabase Dashboard > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase Dashboard > Project Settings > API Keys > "service_role"
# ¡SECRETA! Nunca debe llegar al navegador. VIRTUS TIME la usa como única
# forma de hablar con la base de datos (no usamos contraseñas de Supabase
# Auth, así que no hace falta la clave "anon").
SUPABASE_SERVICE_ROLE_KEY=

# Clave para firmar la cookie de sesión de cada perfil (no es una contraseña
# de nadie, es un secreto del servidor). Genera una cadena aleatoria larga:
#   openssl rand -hex 32
SESSION_SECRET=

# Se usará a partir de la FASE 5 (informes automáticos) para generar las
# conclusiones inteligentes. De momento puedes dejarla vacía.
ANTHROPIC_API_KEY=

# Clave secreta para proteger el endpoint que genera el informe semanal, de
# forma que solo la tarea programada (y nadie más) pueda ejecutarlo.
# Genera una cadena aleatoria larga, por ejemplo con: openssl rand -hex 32
CRON_SECRET=
